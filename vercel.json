{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "outputDirectory": "dist/fuse",
    "rewrites": [
        {
            "source": "/v2/:path*",
            "has": [
                {
                    "type": "host",
                    "value": "staging-access.verifik.co"
                }
            ],
            "destination": "https://staging-api.verifik.co/v2/:path*"
        },
        {
            "source": "/v3/:path*",
            "has": [
                {
                    "type": "host",
                    "value": "staging-access.verifik.co"
                }
            ],
            "destination": "https://staging-api.verifik.co/v3/:path*"
        },
        {
            "source": "/v2/:path*",
            "has": [
                {
                    "type": "host",
                    "value": "sandbox-auth.verifik.co"
                }
            ],
            "destination": "https://staging-api.verifik.co/v2/:path*"
        },
        {
            "source": "/v3/:path*",
            "has": [
                {
                    "type": "host",
                    "value": "sandbox-auth.verifik.co"
                }
            ],
            "destination": "https://staging-api.verifik.co/v3/:path*"
        },
        {
            "source": "/v2/:path*",
            "destination": "https://api.verifik.co/v2/:path*"
        },
        {
            "source": "/v3/:path*",
            "destination": "https://api.verifik.co/v3/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
